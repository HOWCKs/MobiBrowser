<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Pacotes de extensão convertidos, prontos para compartilhar/reinstalar -->
    <files-path
        name="extensions"
        path="extensions/" />
    <!-- User scripts exportados -->
    <files-path
        name="userscripts"
        path="userscripts/" />
    <cache-path
        name="staging"
        path="ext-staging/" />
    <!-- APK baixado pelo verificador de atualização: o instalador do sistema só aceita
         conteúdo entregue por URI de provider, nunca file:// cru (TransactionTooLarge + V7). -->
    <files-path
        name="updates"
        path="updates/" />
</paths>
